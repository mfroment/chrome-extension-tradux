{
  "manifest_version": 3,
  "name": "TraduX",
  "version": "0.3",
  "description": "Translate tweets to your target language using OpenAI",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
      "https://api.openai.com/*",
      "*://x.com/*"
    ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_light.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
