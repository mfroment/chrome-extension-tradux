{
  "manifest_version": 3,
  "name": "TraduX",
  "version": "1.0.0",
  "description": "Translate X posts using external LLM APIs",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "*://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon_light.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
